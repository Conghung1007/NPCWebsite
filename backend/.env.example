# Database

DATABASE_URL=



# Session

SESSION_SECRET=



# Public site URL — production apex (PayOS fallback + cookie domain derivation)

# Local: http://localhost:5000

# Prod:  https://npgroup.vn

PUBLIC_APP_URL=http://localhost:5000



# Shared session/cart cookie across portal subdomains (prod only)

# COOKIE_DOMAIN=.npgroup.vn



# Extra CORS origins (comma-separated), optional

# ALLOWED_ORIGINS=https://staging.example.com



# PayOS Merchant (https://my.payos.vn)

PAYOS_CLIENT_ID=

PAYOS_API_KEY=

PAYOS_CHECKSUM_KEY=

# Optional full-URL overrides (default: current Host / portal origin + path)

# PAYOS_RETURN_URL=https://tnjs.npgroup.vn/checkout/success

# PAYOS_CANCEL_URL=https://tnjs.npgroup.vn/checkout/cancel

# Webhook URL in PayOS dashboard: https://npgroup.vn/api/webhooks/payos



# Cloudflare R2 (primary) — required on Render for /api/proxy-image and uploads

R2_PRIMARY_ACCOUNT_ID=

R2_PRIMARY_ACCESS_KEY_ID=

R2_PRIMARY_SECRET_ACCESS_KEY=

R2_PRIMARY_BUCKET_NAME=

R2_PRIMARY_ENDPOINT=



# Portals — Phase 0/4: 1 Render service + 4 custom domains

# Apex: https://npgroup.vn

#       https://tnjs.npgroup.vn

#       https://duhoc.npgroup.vn

#       https://daotao.npgroup.vn

#

# Set these on Render BEFORE rebuild (Vite bakes VITE_* at build time):

# VITE_GROUP_ORIGIN=https://npgroup.vn

# VITE_TNJS_ORIGIN=https://tnjs.npgroup.vn

# VITE_DUHOC_ORIGIN=https://duhoc.npgroup.vn

# VITE_DAOTAO_ORIGIN=https://daotao.npgroup.vn

#

# DNS checklist (registrar → values from Render → Custom Domains):

# 1. Add domains on Render service npc-website (or apply render.yaml domains)

# 2. Point DNS records Render shows (usually CNAME to xxx.onrender.com)

# 3. Wait SSL certificates green for all 4 hosts

# 4. Set PUBLIC_APP_URL + COOKIE_DOMAIN + VITE_* then Clear build cache + Redeploy

# 5. Smoke: https://npgroup.vn/api/health , tnjs/duhoc/daotao home, login persists across subdomains

# 6. Update PayOS return/webhook URLs; R2 CORS may keep AllowedOrigins ["*"] or list the 4 https origins

