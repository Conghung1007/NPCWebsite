# Database

DATABASE_URL=



# Session

SESSION_SECRET=



# Public site URL — single apex (path-based portals)

# Local: http://localhost:5000

# Prod:  https://trinhanacademy.com

PUBLIC_APP_URL=http://localhost:5000



# Optional cookie Domain (usually omit — one host uses host-only cookies).
# Do NOT set this to .onrender.com — browsers reject that public suffix.

# COOKIE_DOMAIN=.trinhanacademy.com



# Extra CORS origins (comma-separated), optional

# ALLOWED_ORIGINS=https://staging.example.com



# PayOS Merchant (https://my.payos.vn)

PAYOS_CLIENT_ID=

PAYOS_API_KEY=

PAYOS_CHECKSUM_KEY=

# Optional full-URL overrides (default: current Host + path)

# PAYOS_RETURN_URL=https://trinhanacademy.com/luyen-thi/checkout/success

# PAYOS_CANCEL_URL=https://trinhanacademy.com/luyen-thi/checkout/cancel

# Webhook URL in PayOS dashboard: https://trinhanacademy.com/api/webhooks/payos



# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:5173, https://your-domain
# Authorized redirect URIs: not required for GIS One Tap / button flow
GOOGLE_CLIENT_ID=


RESEND_API_KEY=

# Verified sender on Resend (tnjs.vn). Example:
# RESEND_FROM_EMAIL=TNJS <support@tnjs.vn>

RESEND_FROM_EMAIL=

# Display name in OTP emails (default: TNJS)

EMAIL_APP_NAME=TNJS



# Cloudflare R2 (primary) — required on Render for /api/proxy-image and uploads

R2_PRIMARY_ACCOUNT_ID=

R2_PRIMARY_ACCESS_KEY_ID=

R2_PRIMARY_SECRET_ACCESS_KEY=

R2_PRIMARY_BUCKET_NAME=

R2_PRIMARY_ENDPOINT=



# Portals — 1 Render service, path prefixes on one domain

# Apex: https://trinhanacademy.com

#   /huong-nghiep/gioi-thieu

#   /dich-vu/gioi-thieu

#   /luyen-thi/gioi-thieu

# External đào tạo: https://tnjs.vn

#

# DNS checklist (registrar → values from Render → Custom Domains):

# 1. Add apex (+ www) on Render service npc-website

# 2. Point DNS records Render shows (usually CNAME to xxx.onrender.com)

# 3. Wait SSL certificates green

# 4. Set PUBLIC_APP_URL then Clear build cache + Redeploy

# 5. Smoke: /api/health , /huong-nghiep/gioi-thieu , /dich-vu/gioi-thieu , /luyen-thi/classes

# 6. Update PayOS return/webhook URLs; R2 CORS may keep AllowedOrigins ["*"]

