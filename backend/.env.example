# Database

DATABASE_URL=



# Session

SESSION_SECRET=



# Public site URL — production apex (PayOS fallback + cookie domain derivation)

# Local: http://localhost:5000

# Prod:  https://npgroup.vn

PUBLIC_APP_URL=http://localhost:5000



# Shared session/cart cookie across portal subdomains (custom DNS only).
# Do NOT set this to .onrender.com — browsers reject that public suffix.

# COOKIE_DOMAIN=.npgroup.vn



# Extra CORS origins (comma-separated), optional

# ALLOWED_ORIGINS=https://staging.example.com



# PayOS Merchant (https://my.payos.vn)

PAYOS_CLIENT_ID=

PAYOS_API_KEY=

PAYOS_CHECKSUM_KEY=

# Optional full-URL overrides (default: current Host / portal origin + path)

# PAYOS_RETURN_URL=https://luyenthi.npgroup.com/checkout/success

# PAYOS_CANCEL_URL=https://luyenthi.npgroup.com/checkout/cancel

# Webhook URL in PayOS dashboard: https://npgroup.com/api/webhooks/payos



# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:5173, https://your-domain
# Authorized redirect URIs: not required for GIS One Tap / button flow
GOOGLE_CLIENT_ID=


RESEND_API_KEY=

# Verified sender on Resend (tnjs.vn). Example:
# RESEND_FROM_EMAIL=TNJS <support@tnjs.vn>

RESEND_FROM_EMAIL=

# Display name in OTP emails (default: TNJS)

EMAIL_APP_NAME=TNJS



# Cloudflare R2 (primary) — required on Render for /api/proxy-image and uploads

R2_PRIMARY_ACCOUNT_ID=

R2_PRIMARY_ACCESS_KEY_ID=

R2_PRIMARY_SECRET_ACCESS_KEY=

R2_PRIMARY_BUCKET_NAME=

R2_PRIMARY_ENDPOINT=



# Portals — 1 Render service + custom domains

# Apex: https://npgroup.com

#       https://huongnghiep.npgroup.com

#       https://dichvu.npgroup.com

#       https://luyenthi.npgroup.com

# External đào tạo: https://tnjs.vn

#

# Set these on Render BEFORE rebuild (Vite bakes VITE_* at build time):

# VITE_GROUP_ORIGIN=https://npgroup.com

# VITE_HUONGNGHIEP_ORIGIN=https://huongnghiep.npgroup.com

# VITE_DICHVU_ORIGIN=https://dichvu.npgroup.com

# VITE_LUYENTHI_ORIGIN=https://luyenthi.npgroup.com

#

# DNS checklist (registrar → values from Render → Custom Domains):

# 1. Add domains on Render service npc-website (or apply render.yaml domains)

# 2. Point DNS records Render shows (usually CNAME to xxx.onrender.com)

# 3. Wait SSL certificates green for all hosts

# 4. Set PUBLIC_APP_URL + COOKIE_DOMAIN + VITE_* then Clear build cache + Redeploy

# 5. Smoke: https://npgroup.com/api/health , huongnghiep/dichvu/luyenthi home, login persists across subdomains

# 6. Update PayOS return/webhook URLs; R2 CORS may keep AllowedOrigins ["*"] or list the https origins

